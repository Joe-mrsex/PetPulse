rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Foto de perfil: solo el dueño puede subir/editar la suya, cualquier
    // usuario autenticado puede verla (necesario para matches y chat).
    match /profile_photos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Fotos de mascotas: solo el refugio dueño puede subir.
    match /pet_photos/{shelterId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == shelterId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Carnet de vacunación: imagen o PDF, subido por el dueño del recurso.
    match /vaccine_cards/{ownerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == ownerId
                   && request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }
  }
}
