rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario puede leer cualquier perfil (para verse entre sí en
    // matches/chat) pero solo puede escribir el suyo propio.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Cualquiera autenticado puede ver mascotas activas; solo el refugio
    // dueño puede crear/editar sus propias publicaciones.
    match /pets/{petId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.shelterId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.shelterId == request.auth.uid;
    }

    // Un match solo lo pueden leer/escribir el adoptante o el refugio
    // involucrados en esa solicitud.
    match /matches/{matchId} {
      allow read: if request.auth != null &&
        (resource.data.adopterId == request.auth.uid || resource.data.shelterId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.adopterId == request.auth.uid;
      allow update: if request.auth != null &&
        (resource.data.adopterId == request.auth.uid || resource.data.shelterId == request.auth.uid);
      allow delete: if false;
    }

    // El chat y sus mensajes solo son visibles para sus participantes.
    match /chats/{chatId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
